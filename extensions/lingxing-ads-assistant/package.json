{
  "name": "lingxing-ads-assistant",
  "version": "0.8.4",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test test/*.test.mjs",
    "check": "npm test && npm run build",
