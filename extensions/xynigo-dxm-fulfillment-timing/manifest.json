{
  "manifest_version": 3,
  "name": "Xynigo 店小秘履约时效助手",
  "short_name": "履约时效助手",
  "version": "0.1.0",
  "version_name": "0.1.0-interface-direct-v1",
  "description": "在店小秘物流追踪-已签收面板一键统计备货/揽收/运输/履约时效,支持店铺账号与订单批量筛选、时效分段与 CSV 导出。",
  "permissions": [
    "storage"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://dianxiaomi.com/web/otherFeatures/tracking*",
        "https://*.dianxiaomi.com/web/otherFeatures/tracking*"
      ],
      "js": [
        "src/inject.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://dianxiaomi.com/web/otherFeatures/tracking*",
        "https://*.dianxiaomi.com/web/otherFeatures/tracking*"
      ],
      "js": [
        "src/core.js",
        "src/content.js"
      ],
      "css": [
        "src/panel.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "homepage_url": "https://github.com/wrangler1024/crossborder-userscripts/tree/main/extensions/xynigo-dxm-fulfillment-timing"
}
