{
  "manifest_version": 3,
  "name": "Xynigo SHEIN 采购助手",
  "short_name": "SHEIN 采购助手",
  "version": "0.9.0",
  "version_name": "0.9.0-purchase-details-preview",
  "description": "采购地址填写与墨西哥订单详情凭证回传，需配套 Xynigo 执行器。",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "http://xynigo.localhost/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Xynigo SHEIN 采购助手",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "commands": {
    "open-purchase-assistant": {
      "suggested_key": {
        "default": "Alt+Shift+P"
      },
      "description": "打开 SHEIN 采购助手窗口"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.shein.com.mx/*",
        "https://m.shein.com.mx/*",
        "https://us.shein.com/*"
      ],
      "js": [
        "src/core.js",
        "src/purchase-details.js",
        "src/content.js"
      ],
      "css": [
        "src/content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/icon48.png"
      ],
      "matches": [
        "https://www.shein.com.mx/*",
        "https://m.shein.com.mx/*",
        "https://us.shein.com/*"
      ]
    }
  ]
}
