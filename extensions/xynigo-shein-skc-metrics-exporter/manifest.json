{
  "manifest_version": 3,
  "name": "Xynigo SHEIN 商品分析指标导出",
  "short_name": "SKC 指标导出",
  "version": "0.3.1",
  "description": "只读采集 SHEIN 卖家后台商品分析列表（SKC/SPU）的可见指标，支持勾选列、原价/特价分列与自动翻页，导出含商品缩略图的 Excel(.xlsx) 或 CSV。",
  "icons": {
    "16": "xynigo-mascot.png",
    "32": "xynigo-mascot.png",
    "48": "xynigo-mascot.png",
    "128": "xynigo-mascot.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://sellerhub.shein.com/*"
      ],
      "js": [
        "vendor/jszip.min.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "homepage_url": "https://github.com/wrangler1024/crossborder-userscripts/tree/main/scripts/shein-skc-metrics-exporter"
}
