{
  "manifest_version": 3,
  "name": "领星 Vine 推广标注助手",
  "short_name": "Vine 推广助手",
  "version": "0.1.4",
  "version_name": "0.1.4-dual-channel",
  "description": "只读检查领星 Vine 订单并预览待标清单，人工确认后小批量标记为推广订单并回读校验。",
  "minimum_chrome_version": "111",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://erp.lingxing.com/*",
    "https://gw.lingxingerp.com/*"
  ],
  "action": {
    "default_title": "领星 Vine 推广标注助手",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    },
    "default_popup": "popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://erp.lingxing.com/erp/*"
      ],
      "js": [
        "src/page-session.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": [
        "https://erp.lingxing.com/erp/*"
      ],
      "js": [
        "src/core.js",
        "src/content.js"
      ],
      "run_at": "document_idle",
      "world": "ISOLATED",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/panel.css"
      ],
      "matches": [
        "https://erp.lingxing.com/*"
      ]
    }
  ]
}
