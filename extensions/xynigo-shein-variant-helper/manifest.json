{
  "manifest_version": 3,
  "name": "Xynigo SHEIN 商品型号助手",
  "short_name": "SHEIN 型号助手",
  "version": "0.1.14",
  "description": "校验 SHEIN 商品主规格、次规格、实时售价与库存，并复制三行采购信息。",
  "permissions": [
    "clipboardWrite"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://us.shein.com/*",
        "https://shein.com.mx/*",
        "https://*.shein.com.mx/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "homepage_url": "https://github.com/wrangler1024/crossborder-userscripts/tree/main/scripts/shein-product-variant-helper"
}
