{
  "manifest_version": 3,
  "name": "Xynigo SHEIN Captcha Auto Solver",
  "short_name": "Xynigo Captcha Solver",
  "version": "0.4.0",
  "description": "SHEIN 九宫格验证码自动求解：视觉模型可配置（智谱/豆包/Gemini/自定义），支持双模型对比与样本回放评测。",
  "permissions": [
    "storage",
    "unlimitedStorage"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "host_permissions": [
    "https://us.shein.com/*",
    "https://*.shein.com/*",
    "https://shein.com.mx/*",
    "https://*.shein.com.mx/*",
    "https://*.ltwebstatic.com/*",
    "https://open.bigmodel.cn/*",
    "https://ark.cn-beijing.volces.com/*",
    "https://generativelanguage.googleapis.com/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Xynigo SHEIN Captcha Solver",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    },
    "default_popup": "popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://us.shein.com/*",
        "https://shein.com.mx/*",
        "https://*.shein.com.mx/*"
      ],
      "js": [
        "src/config.js",
        "src/puzzle.js",
        "src/vision-client.js",
        "src/stats.js",
        "src/captcha-agent.js",
        "src/content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
