{
  "manifest_version": 3,
  "name": "Xynigo 店小秘运营采购助手",
  "short_name": "运营采购助手",
  "version": "0.11.0",
  "version_name": "0.11.0-xynigo-test",
  "description": "在店小秘订单详情中录入并提交采购信息，复用 Xynigo 登录身份和采购权限，不影响店小秘原有审核流程。",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "externally_connectable": {
    "matches": [
      "http://127.0.0.1/*"
    ]
  },
  "action": {
    "default_title": "Xynigo 店小秘运营采购助手",
    "default_popup": "popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://dianxiaomi.com/*",
        "https://*.dianxiaomi.com/*"
      ],
      "js": [
        "src/core.js",
        "src/content.js"
      ],
      "css": [
        "src/content.css"
      ],
      "run_at": "document_start"
    }
  ],
  "homepage_url": "https://github.com/wrangler1024/crossborder-userscripts/tree/main/extensions/xynigo-dxm-purchase-assistant"
}
