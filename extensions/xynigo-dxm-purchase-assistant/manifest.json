{
  "manifest_version": 3,
  "name": "Xynigo 店小秘运营采购助手",
  "short_name": "运营采购助手",
  "version": "0.12.1",
  "version_name": "0.12.1-standalone-cloud-login-test",
  "description": "在店小秘订单详情中录入采购信息，使用飞书独立登录 Xynigo 云端并生成紧凑 XYP2 过渡备注。",
  "permissions": [
    "storage",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://xynigo.samforo.icu/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_title": "Xynigo 店小秘运营采购助手",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    },
    "default_popup": "popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://dianxiaomi.com/*",
        "https://*.dianxiaomi.com/*"
      ],
      "js": [
        "src/core.js",
        "src/content.js"
      ],
      "css": [
        "src/content.css"
      ],
      "run_at": "document_start"
    }
  ],
  "homepage_url": "https://github.com/wrangler1024/crossborder-userscripts/tree/main/extensions/xynigo-dxm-purchase-assistant"
}
